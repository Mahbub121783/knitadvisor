# ─────────────────────────────────────────────────────────────
# Database (cPanel MySQL) — REQUIRED
# The app refuses to start without these. There are deliberately no
# hardcoded fallbacks in config/database.js: this repository is public,
# and defaults there meant production ran on repo-readable credentials.
# ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=tecnedub_knitadvisor
DB_PASS=your_db_password_here
DB_NAME=tecnedub_knitadvisor
DB_PORT=3306

# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─────────────────────────────────────────────────────────────
# Secrets — REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────

# Encrypts AI provider API keys at rest in the ai_provider_keys table.
# Min 16 chars. Changing it makes existing stored keys unreadable — migrate
# with: node scripts/reencrypt-provider-keys.js --apply
API_KEY_ENCRYPTION_SECRET=

# Optional: changes the KDF salt alongside the secret. Leave unset to use
# the built-in v2 salt.
# API_KEY_ENCRYPTION_SALT=

# Salts the visitor-IP hash written to query_logs. Without it the digest is
# reversible by brute force (IPv4 is only 4 billion values).
IP_HASH_SALT=

# ─────────────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────────────

# Extra browser origins allowed to call the API, comma-separated.
# Same-origin always works; leave empty unless another site embeds the API.
# CORS_ORIGINS=https://www.onlinetextileschool.com

# Username/password for the first admin seeded into an empty admin_users
# table. If unset, a random password is generated and printed to the log once.
# ADMIN_SEED_USER=knitadvisor
# ADMIN_SEED_PASSWORD=

# Mounts the unauthenticated /emergency/* recovery routes. Leave unset.
# Only set to "enabled" during an incident where SSH is unavailable, and
# unset it immediately afterwards.
# EMERGENCY_ROUTES=

# Result cache TTL in seconds (default 30 days)
CACHE_TTL_SECONDS=2592000
