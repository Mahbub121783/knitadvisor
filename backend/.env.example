# ─────────────────────────────────────────────────────────────
# PostgreSQL — REQUIRED
# The app refuses to start without these. There are deliberately no
# hardcoded fallbacks in db/client.js: this repository is public, and
# defaults there once meant production ran on repo-readable credentials.
# ─────────────────────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGUSER=tecnedub_knitadv
PGPASSWORD=your_db_password_here
PGDATABASE=tecnedub_knitadvisor

# Per-process pool ceiling. Passenger runs several workers, so the real
# connection count is this times the worker count.
# PGPOOL_MAX=5
# PG_STATEMENT_TIMEOUT_MS=10000
# PG_SLOW_QUERY_MS=300

# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# Day boundaries for the analytics rollups. The server clock is Mountain
# time; without this "today" would flip around midday in Bangladesh.
BUSINESS_TIMEZONE=Asia/Dhaka

# ─────────────────────────────────────────────────────────────
# Secrets — REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────

# Encrypts AI provider API keys at rest in ai_provider_keys. Min 16 chars.
# Changing it makes stored keys unreadable — migrate with:
#   node scripts/reencrypt-provider-keys.js --apply
API_KEY_ENCRYPTION_SECRET=

# Optional: changes the KDF salt alongside the secret.
# API_KEY_ENCRYPTION_SALT=

# Salts the visitor-IP hash in query_logs. Without it the digest is
# reversible by brute force (IPv4 is only 4 billion values).
IP_HASH_SALT=

# Authenticates /internal-cron?job=...&secret=... Min 16 chars.
# These jobs mutate data and trigger backups, so treat it like a password.
INTERNAL_CRON_SECRET=

# ─────────────────────────────────────────────────────────────
# Scheduled maintenance (see routes/internal-cron.js)
# ─────────────────────────────────────────────────────────────
# BACKUP_DIR=/home/tecnedub/backups/knitadvisor
# BACKUP_KEEP_DAYS=14
# QUERY_LOG_RETENTION_DAYS=180
# LOG_MAX_BYTES=5242880

# ─────────────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────────────

# Extra browser origins allowed to call the API, comma-separated.
# Same-origin always works; leave empty unless another site embeds the API.
# CORS_ORIGINS=https://www.onlinetextileschool.com

# First admin seeded into an empty admin_users table. If unset, a random
# password is generated and printed to the log once.
# ADMIN_SEED_USER=knitadvisor
# ADMIN_SEED_PASSWORD=

# AI provider call budget. Each attempt is capped at AI_PROVIDER_TIMEOUT_MS
# and parse() walks providers x keys x models under AI_PARSE_BUDGET_MS.
# AI_PROVIDER_TIMEOUT_MS=12000
# AI_PARSE_BUDGET_MS=25000

# Result cache TTL in seconds (default 30 days)
CACHE_TTL_SECONDS=2592000

# ─────────────────────────────────────────────────────────────
# Legacy MySQL — only needed while running
# scripts/migrate-mysql-to-postgres.js. Delete after the cutover.
# ─────────────────────────────────────────────────────────────
# MYSQL_HOST=localhost
# MYSQL_USER=tecnedub_knitadvisor
# MYSQL_PASS=
# MYSQL_NAME=tecnedub_knitadvisor
# MYSQL_PORT=3306
