# The whole Claude Code project-local config dir — not just settings.local.json.
# settings.json itself (permissions allowlist) got committed for months before
# this line existed, along with 153 commits' worth of "Co-Authored-By: Claude"
# trailers; both were scrubbed from all history 2026-09-13. This ignores the
# entire directory so nothing under .claude/ can be re-added by accident again.
.claude/

# local-only verification scratch
.verify/

# Python bytecode from running the extraction scripts
__pycache__/
*.pyc
